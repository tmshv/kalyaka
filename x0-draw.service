[Unit]
Description=kalyaka drawing sheet behind Caddy on x0
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/x0-draw -listen 127.0.0.1:20480
Restart=on-failure
RestartSec=2s
# Stores nothing, so it needs no user, no files and nothing outside loopback.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
